<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <queries>
        <!-- The optional experiment probes only the supported Android TV YouTube app. -->
        <package android:name="com.google.android.youtube.tv" />
    </queries>
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="${allowCleartext}"
        android:icon="@drawable/ic_mompilot"
        android:banner="@drawable/tv_banner"
        android:label="MomPilot"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
